{
  "name": "backend-pms-api",
  "version": "1.0.0",
  "description": "Project Management System (PMS) Backend API",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "nodemon --watch src -e ts --exec ts-node src/main.ts",
    "init-db": "ts-node src/main.ts --init",
    "test": "mocha --require ts-node/register 'tests/**/*.test.ts' --timeout 10000 --exit",
    "test:coverage": "nyc npm test"
  },
  "dependencies": {
    "amqplib": "^0.10.3",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "bull": "^4.12.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/bull": "^4.10.0",
    "@types/chai": "^4.3.11",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.11.5",
    "@types/redis": "^4.0.11",
    "@types/sinon": "^17.0.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "chai": "^4.3.10",
    "javascript-obfuscator": "^4.1.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.1.0",
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
